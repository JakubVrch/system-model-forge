{
  "name": "governed-model-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "knip": "^6.45.1",
    "tsc-alias": "^1.9.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "bin": {
    "model-forge": "dist/cli/main.js"
  },
  "files": [
    "dist/"
  ]
}
